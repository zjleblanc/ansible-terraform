---
# Ansible Lint — https://ansible.readthedocs.io/projects/lint/configuring/
# Profiles: https://ansible.readthedocs.io/projects/lint/profiles/
# This repo mixes Terraform automation (cloud.terraform, hashicorp.terraform) with playbooks and roles.
profile: shared

exclude_paths:
  - .cache/
  - .github/
  - "**/.terraform/"

offline: true

# Syntax-check without requiring `ansible-galaxy collection install` in every environment.
# Prefer installing declared collections and dropping mocks when you want full module validation.
mock_modules:
  - ansible.posix.firewalld
  - cloud.terraform.terraform
  - community.crypto.openssh_keypair
  - hashicorp.terraform.run
  - hashicorp.terraform.workspace_info

use_default_rules: true

# Opt-in rules (not implied by profile: shared alone). Omit `args` while mock_modules are in use
# (args validation resolves against stub specs and floods false positives).
enable_list:
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - yaml

# Keep shared as the gate; soften a few rules that are noisy for this layout until refactors land.
warn_list:
  - jinja[spacing]
  - var-naming[no-role-prefix]
  - yaml[line-length]
  - risky-file-permissions

progressive: false
